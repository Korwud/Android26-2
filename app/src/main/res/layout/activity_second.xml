<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    tools:context=".SecondActivity">

    <Toolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:title="@string/article_title"
        android:navigationIcon="@drawable/arrow_back" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:id="@+id/introduction"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/introduction"
                android:textSize="18sp"
                android:paddingHorizontal="15dp"
                android:paddingBottom="10dp"/>

            <TextView
                android:id="@+id/Achichi_Mela_text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/Achichi_Mela"
                android:textSize="14sp"
                android:paddingHorizontal="15dp"
                android:paddingBottom="10dp"/>

            <ImageView
                android:id="@+id/Achichi_Mela_image"
                android:layout_width="match_parent"
                android:layout_height="300dp"
                android:paddingBottom="25dp"/>

            <TextView
                android:id="@+id/Sorashina_Sopia_text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/Sorashina_Sopia"
                android:textSize="14sp"
                android:paddingHorizontal="15dp"
                android:paddingBottom="10dp"/>

            <ImageView
                android:id="@+id/Sorashina_Sopia_image"
                android:layout_width="match_parent"
                android:layout_height="300dp"
                android:paddingBottom="25dp"/>

            <TextView
                android:id="@+id/Suzuna_Tsuzuri_text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/Suzuna_Tsuzuri"
                android:textSize="14sp"
                android:paddingHorizontal="15dp"
                android:paddingBottom="10dp"/>

            <ImageView
                android:id="@+id/Suzuna_Tsuzuri_image"
                android:layout_width="match_parent"
                android:layout_height="300dp"
                android:paddingBottom="25dp"/>

            <TextView
                android:id="@+id/Hyakuto_Kyoko_text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/Hyakuto_Kyoko"
                android:textSize="14sp"
                android:paddingHorizontal="15dp"
                android:paddingBottom="10dp"/>

            <ImageView
                android:id="@+id/Hyakuto_Kyoko_image"
                android:layout_width="match_parent"
                android:layout_height="300dp"
                android:paddingBottom="25dp"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:padding="15dp">

                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/switchRead"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/switch_read" />

                <Button
                    android:id="@+id/buttonShare"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:text="@string/share"
                    android:backgroundTint="#6200EE"
                    android:textColor="#FFFFFF" />

            </LinearLayout>

        </LinearLayout>

    </ScrollView>

</LinearLayout>